{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "database.rules.json",
      "README.md",
      "**/.*",
      "**/node_modules/**",
      "*.zip",
      "*.sha256"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html|json|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
