          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'mentor' || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('type').val() === 'payment'))"
        }
